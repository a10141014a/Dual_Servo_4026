<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Initial_POU" Id="{9593bfb5-296d-4592-9257-2c0aff8b49cd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Initial_POU
VAR
	nStep	:INT;
	strText	:STRING;
	nErrorStep : INT := -1; // Original failed Initial_POU step; -1 = no error
	strErrorDetail,strErrorText,strUnitText : STRING;
	i : INT;
	aryBit	:ARRAY [0..100] OF BOOL;
	dwError: DWORD;
	tmrDelay,tmrDone	:TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE nStep OF
	0:
		Motor_Blower.qRun	:=FALSE;
		tmrDelay(IN:=FALSE);
		tmrDone(IN:=FALSE);
		nErrorStep:=-1;
		strErrorDetail:='';
		strErrorText:='';
		strUnitText:='';
		dwError:=0;
		FOR i:=0 TO 9 DO
			aryBit[i]:=FALSE;
		END_FOR
		strText:='I0 Check Recipe Selection';
		EventLogger.eEventType:=2;
		EventLogger.strEventText:=strText;
		EventLogger();
		OP.xInitialDone:=FALSE;
		IF LEN(RunParameter.strName)=0 THEN
			strErrorDetail:='No recipe selected';
			nStep:=100;
		ELSE
			nStep:=5;
		END_IF

	5:
		strText:='I5 Load and Apply Recipe';
		tmrDelay(IN:=TRUE,PT:=T#5S);
		IF tmrDelay.Q THEN
			strErrorDetail:='Recipe load timeout';
			nStep:=105;
		ELSE
			dwError:=RecipeManCommands.LoadAndWriteRecipe(
				RecipeDefinitionName:='Recipes', RecipeName:=RunParameter.strName);
			IF dwError=0 THEN
				RunParameter:=Edit_Parameter;
				tmrDelay(IN:=FALSE);
				nStep:=6;
			ELSE
				strErrorDetail:=CONCAT('Recipe load failed, code=',DWORD_TO_STRING(dwError));
				nStep:=105;
			END_IF
		END_IF

	6:
		strText:='I6 Reset Errors / Check Air Pressure';
		MainControl.ErrorReset();
		IF Air_Signal THEN
			nStep:=10;
		ELSE
			strErrorDetail:='Insufficient air pressure';
			nStep:=106;
		END_IF

	10:
		strText:='I10 Initialize CS Robot';
		tmrDelay(IN:=TRUE,PT:=T#50S);
		aryBit[7]:=RB_CS.Initialization();
		// RB_KR initialization remains disabled.
		tmrDone(IN:=aryBit[7],PT:=T#0.1S);
		// Faults take priority over completion in the same scan.
		IF RB_CS.CommandError THEN
			strErrorDetail:='CS robot initialization command error';
			nStep:=110;
		ELSIF tmrDelay.Q THEN
			strErrorDetail:='CS robot initialization timeout';
			nStep:=110;
		ELSIF tmrDone.Q THEN
			tmrDelay(IN:=FALSE);
			tmrDone(IN:=FALSE);
			nStep:=20;
		END_IF

	20:
		// Keep all units running in parallel; display the first unfinished unit.
		aryBit[0]:=M_DualServo.Initialization();
		aryBit[1]:=M_Openbox1.Initialization();
		aryBit[2]:=M_Sealing2.Initialization();
		aryBit[3]:=M_LoadPic3.Initialization();
		aryBit[4]:=M_UnloadNG4.Initialization();
		aryBit[5]:=M_StackComv5.Initialization();
		aryBit[6]:=M_RBStack6.Initialization();

		IF NOT aryBit[0] THEN
			strUnitText:=M_DualServo.strText;
		ELSIF NOT aryBit[1] THEN
			strUnitText:=M_Openbox1.strText;
		ELSIF NOT aryBit[2] THEN
			strUnitText:=M_Sealing2.strText;
		ELSIF NOT aryBit[3] THEN
			strUnitText:=M_LoadPic3.strText;
		ELSIF NOT aryBit[4] THEN
			strUnitText:=M_UnloadNG4.strText;
		ELSIF NOT aryBit[5] THEN
			strUnitText:=M_StackComv5.strText;
		ELSIF NOT aryBit[6] THEN
			strUnitText:=M_RBStack6.strText;
		ELSE
			strUnitText:='All units ready - confirm completion';
		END_IF
		strText:=CONCAT('I20 ',strUnitText);
		tmrDelay(IN:=TRUE,PT:=T#50S);
		tmrDone(IN:=aryBit[0] AND aryBit[1] AND aryBit[2] AND aryBit[3]
			AND aryBit[4] AND aryBit[5] AND aryBit[6],PT:=T#0.1S);
		IF tmrDelay.Q THEN
			strErrorDetail:=CONCAT('Timeout: ',strUnitText);
			nStep:=120;
		ELSIF tmrDone.Q THEN
			tmrDone(IN:=FALSE);
			tmrDelay(IN:=FALSE);
			nStep:=49;
		END_IF

	49:
		strText:='I49 Start CS Robot Production Program';
		aryBit[9]:=RB_CS.POU_Run(Numb:=Parameter_PERSISTENT.RunParameter.Load_RBPrgNo);
		IF RB_CS.CommandError THEN
			strErrorDetail:='CS robot production program command error';
			nStep:=149;
		ELSIF aryBit[9] THEN
			EventLogger.eEventType:=1;
			EventLogger.strEventText:='I50 Complete';
			EventLogger();
			nStep:=50;
			Motor_Blower.qRun:= TRUE;
			strText:='I50 Complete';
		END_IF

	50:
		strText:='I50 Complete';
		OP.xInitialDone:=TRUE;

	100..199:
		; // Error details are latched below, including on the first fault scan.

	200..299:
		strText:=strErrorText; // Retain the original failed step until restart.
END_CASE

IF (nStep>=100) AND (nStep<=199) THEN
	nErrorStep:=nStep-100;
	IF LEN(strErrorDetail)=0 THEN
		strErrorDetail:='Initialization cancelled';
	END_IF
	strErrorText:=CONCAT(CONCAT('I',INT_TO_STRING(nErrorStep)),' ERR ');
	strErrorText:=CONCAT(strErrorText,strErrorDetail);
	strText:=strErrorText;
	OP.xInitialDone:=FALSE;
	tmrDelay(IN:=FALSE);
	tmrDone(IN:=FALSE);
	EventLogger.eEventType:=3;
	EventLogger.strEventText:=strErrorText;
	EventLogger();
	nStep:=nStep+100;
END_IF]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{f0e1d5c9-cb6f-4d69-9756-baed2e282f23}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nStep	:= 0;
strText	:= '';
nErrorStep:= -1;
strErrorDetail:= '';
strErrorText:= '';
strUnitText:= '';]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
