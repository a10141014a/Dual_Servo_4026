<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="Automatic_POU" Id="{d539cfdc-f8c2-4c03-ad90-2b9ea190d71a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Automatic_POU
VAR
	nStep 			:INT;
	bHlatMode,bNextStep		:BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//實例化

CASE  nStep OF
	0:
	IF NOT Setting_HalfMode THEN
		M_Openbox1.Process(bHlatMode);
		M_Sealing2.Process(FALSE);
		M_LoadPic3.Process(FALSE);
		M_UnloadNG4.Process(FALSE);
		M_DualServo.Process(FALSE);
		M_StackComv5.Process(FALSE);
		M_RBStack6.Process(FALSE);
		ELSE
		Cyl_FlyIn_Pass	:= TRUE;
		M_UnloadNG4.Process(FALSE);	
		M_StackComv5.Process(FALSE);
		M_RBStack6.Process(FALSE);			
	END_IF;
	
	
	
	
END_CASE
IF bNextStep THEN
	M_Openbox1.HaltStepContiune();
	bNextStep:=FALSE;
END_IF

IF Axis_load1.Status.Error OR Axis_load2.Status.Error OR Axis_FlyIn.Status.Error OR Axis_BoxPullOut.Status.Error
	OR Axis_DualServo1.Status.Error OR Axis_DualServo2.Status.Error THEN
	MainControl.StopAllAxes();	
	MainControl.StopMotor();
	MainControl.StopAir();
	OP.xAutoRuning				:= FALSE;
	OP.xInitialRuning			:=FALSE;	
	OP.bInitialSign				:=FALSE;
	OP.xAutoMode				:=FALSE;
	RB_CS_SysIO.qENABLE			:= FALSE;
	RB_CS_SysIO.qSTOP			:= TRUE;
	RB_KR_SysIO.qMOVE_ENABLE	:= FALSE;
	EventLogger.eEventType		:= 3;
	EventLogger.strEventText	:= 'Auto Shutdown!';
	EventLogger();	
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>