<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="MAIN" Id="{bbb2616a-be8a-4b16-b012-4fc48c768fe4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	bInitial								:BOOL:= TRUE;;				//初始化
	ResetTrigger,AutoRunInitTrigger,PB_StartTrigger,IntiStartTrigger 	:R_TRIG;
	AutoRunDownTrigger,InitailDownTrigger	:F_TRIG;
	BoxSizeView								:REAL;
	i										:INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//常態掃描  
RunParameter.strName	:= F_TrimRightSpace(RunParameter.strName);
Manual_POU();
ErrorFlagMapp();
AlarmCheckLight();
BoxSizeView := 690-Parameter_PERSISTENT.RunParameter.Load_RBLoadin ;

IF PB_Stop OR PB_EMG OR OP.bStop_Sign THEN
	OP.xAutoRuning				:= FALSE;
	OP.xInitialRuning			:=FALSE;	
	OP.bInitialSign				:=FALSE;
	OP.xAutoMode				:=FALSE;
	RB_CS_SysIO.qENABLE			:= FALSE;
	RB_CS_SysIO.qSTOP			:= TRUE;
	RB_KR_SysIO.qMOVE_ENABLE	:= FALSE;
	
	MainControl.StopAllAxes();	
	MainControl.StopMotor();
	MainControl.StopAir();
	EventLogger.eEventType	:= 1;
	EventLogger.strEventText	:= 'Auto Stop!';
	EventLogger();		
END_IF
IF OP.bReset THEN
	MainControl.ErrorReset();
END_IF

(*---------------模式切換-------------------*)
IF OP.xAutoRuning OR OP.xAutoRuning THEN
	OP.bChangeMode	:=FALSE;
END_IF

IF OP.bChangeMode THEN
	OP.bChangeMode	:=FALSE;

	IF NOT OP.xAutoMode THEN
		EventLogger.eEventType	:= 1;
		EventLogger.strEventText	:= 'Mode : Auto ';
		EventLogger();
		OP.xAutoMode	:= TRUE;
		ELSE
		EventLogger.eEventType	:= 1;
		EventLogger.strEventText	:= 'Mode : Manual ';
		EventLogger();	
		OP.xAutoMode	:= FALSE;
	END_IF;
END_IF;
(*Stop*)



(*-------------POU Call ---------------*)
IF OP.xAutoRuning THEN
	OP.bInitialSign		:=FALSE;
END_IF;
IF NOT OP.xAutoMode THEN
	OP.xInitialDone	:=FALSE;
	OP.bStart		:=FALSE;
END_IF


PB_StartTrigger(CLK:=OP.bStart );
IntiStartTrigger(CLK:=OP.bInitialSign);
InitailDownTrigger(CLK:=OP.xInitialRuning);

IF OP.xAutoMode THEN
	IF IntiStartTrigger.Q THEN
		Initial_POU.FB_init(FALSE,FALSE);
		IF NOT OP.xAutoRuning THEN
			OP.xInitialRuning		:= TRUE;
			EventLogger.eEventType	:= 2;
			EventLogger.strEventText	:= 'Initial Runing ';
			EventLogger();
			ELSE
			EventLogger.eEventType	:= 4;
			EventLogger.strEventText	:= 'AutoRuning Do not Initial ';
			EventLogger();
		END_IF;
	END_IF;		
	IF PB_StartTrigger.Q AND NOT OP.xAutoRuning THEN
		IF NOT OP.xInitialRuning THEN
			OP.xAutoRuning	:= TRUE;
			EventLogger.eEventType	:= 2;
			EventLogger.strEventText	:= 'Auto Runing ';
			EventLogger();
			ELSE
			EventLogger.eEventType	:= 4;
			EventLogger.strEventText	:= 'Initial Runing,Please Waitting ';
			EventLogger();
		END_IF
	END_IF
END_IF

IF OP.xInitialRuning THEN
	Initial_POU();
END_IF
IF InitailDownTrigger.Q THEN
	MainControl.SoftStopAxis();
END_IF

IF OP.xAutoRuning THEN
	Automatic_POU();
END_IF

]]></ST>
    </Implementation>
    <Action Name="AlarmCheckLight" Id="{0590a612-3189-40c2-8b48-2da1676bc236}">
      <Implementation>
        <ST><![CDATA[ErrorMan.WarningCounts	:= 0;
ErrorMan.AlarmCounts	:= 0 ;
FOR i := 0 TO 50 DO
	IF WarningList[i]  THEN
		ErrorMan.WarningCounts	:= ErrorMan.WarningCounts + 1;
	END_IF
	IF GVL.AlarmList[i]  THEN
		ErrorMan.AlarmCounts	:= ErrorMan.AlarmCounts + 1;
	END_IF
END_FOR

GVL.ErrorMan.Warning	:= ErrorMan.WarningCounts>0;
GVL.ErrorMan.Alarm		:= ErrorMan.AlarmCounts>0;

IF GVL.ErrorMan.Warning OR GVL.ErrorMan.Alarm THEN
	HardwareIO.Light_BZ	:= GVL.SF.SM412;
	HardwareIO.Light_Yellow	:= GVL.SF.SM412;
		IF GVL.MuteBZ THEN
		HardwareIO.Light_BZ	:=FALSE;
		END_IF;
	ELSE
	HardwareIO.Light_BZ	:=FALSE;
	HardwareIO.Light_Yellow	:= FALSE;
END_IF


IF GVL.OP.xAutoRuning THEN
	HardwareIO.Light_Green	:= TRUE;
	ELSIF GVL.OP.xAutoMode THEN
		HardwareIO.Light_Green	:= GVL.SF.SM412;
	ELSE
		HardwareIO.Light_Green	:= FALSE;
END_IF

IF GVL.OP.xAutoMode THEN
	HardwareIO.Light_Red:=FALSE;
	ELSE
	HardwareIO.Light_Red:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="ErrorFlagMapp" Id="{d8cd540b-6b47-4d33-985b-a98540ca2147}">
      <Implementation>
        <ST><![CDATA[GVL.AlarmList[0]:=Cyl_Axis90.bError		;	
//GVL.AlarmList[1]:=Cyl_AxisBottom.bError;	;
GVL.AlarmList[2]:=Cyl_AxisBoxCatch.bError;
GVL.AlarmList[3]:=Cyl_BeltBottom.bError	;
GVL.AlarmList[4]:=Cyl_BeltBottomSup.bError;
GVL.AlarmList[5]:=Cyl_BoxSideBottom.bError;
GVL.AlarmList[6]:=Cyl_BoxSidePitch.bError;
GVL.AlarmList[7]:=Cyl_ExitClip.bError;
GVL.AlarmList[8]:=Cyl_ExitStopper.bError;
GVL.AlarmList[9]:=Cyl_NGPurge.bError;
GVL.AlarmList[10]:=Cyl_ShockStop.bError;
GVL.AlarmList[11]:=Cyl_StackUD.bError;
GVL.AlarmList[12]:=Cyl_UnloadDef.bError;
GVL.AlarmList[13]:=Axis_BoxPullOut.Status.Error;
GVL.AlarmList[14]:=Axis_DualServo1.Status.Error;
GVL.AlarmList[15]:=Axis_DualServo2.Status.Error;
GVL.AlarmList[16]:=Axis_FlyIn.Status.Error;
GVL.AlarmList[17]:=Axis_load1.Status.Error;
GVL.AlarmList[18]:=Axis_load2.Status.Error;
//GVL.AlarmList[19]:=RB_CS.bOffline;
//GVL.AlarmList[20]:=RB_KR.bOffline;
GVL.AlarmList[21]:=PB_EMG;

//Warning
//GVL.WarningList[0]				//CS手臂BG no run 
//GVL.WarningList[1]				//堆疊手臂BG NOT run
//GVL.WarningList[2]				入料開箱-缺紙警報 
//GVL.WarningList[3]				封箱-卡箱異常  
//GVL.WarningList[4]				



//[PLC1]GVL.WarningList[40]			雙伺服輸送-初始化失敗
//[PLC1]GVL.WarningList[41]			開箱-初始化失敗
//[PLC1]GVL.WarningList[42]			裝箱-初始化失敗
//[PLC1]GVL.WarningList[43]			秤重輸送-初始化失敗
//[PLC1]GVL.WarningList[44]			打包堆疊-初始化失敗
//[PLC1]GVL.WarningList[45]			堆疊裝箱-初始化失敗
//[PLC1]GVL.WarningList[46]			取料手臂-初始化失敗
//[PLC1]GVL.WarningList[47]			堆疊手臂-初始化失敗
//[PLC1]GVL.WarningList[48]				
//[PLC1]GVL.WarningList[49]				
//]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>