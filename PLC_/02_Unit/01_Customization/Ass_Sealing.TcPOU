    <Method Name="Pause" Id="{3248126b-b242-4316-ae47-c6ac4ef43604}">
      <Declaration><![CDATA[
METHOD Pause : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Process" Id="{bf7874d8-aa7d-4a83-9850-3952fbf34226}">
      <Declaration><![CDATA[METHOD Process : BOOL
VAR_INPUT
	bHlatMode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

_bProcessScan	:= TRUE;
//判斷 

IF _bError THEN
	strText:=CONCAT(CONCAT('P',INT_TO_STRING(nStep)),' ERR');
END_IF;
//半自動模式
IF NOT bHlatMode  THEN
	nStep:= nNextStep;	
END_IF;

_bHaltPause	:= nStep<> nNextStep;
IF _bError OR _bHaltPause THEN
	RETURN;
END_IF

IF bReload THEN
	nStep	:= 0;
	bReload							:=FALSE;
	Cyl_BeltBottomSup.qExtendCoil	:=FALSE;		
END_IF
//主程序 
IF NOT _bHaltPause THEN
	CASE nStep OF
		0:
			strText:='P0 Wait Load';
			_tmrT0(IN:=FALSE);
			Motor_BoxSealBottom_L.qRun		:=TRUE;
			Motor_BoxSealBottom_R.qRun		:=TRUE;
			nNextStep						:= 5;
		5:
			strText:='P5 Load In';
			IF Sen_BeltLoadIn THEN
				Cyl_BeltBottomSup.qExtendCoil	:=TRUE;
				nNextStep						:= 10;
			END_IF;	
		10:
			strText:='P10 Transfer Box';
			_tmrT0(IN:=TRUE,PT:=T#6S);	
			
			IF Sen_BeltLoadOut THEN
				_tmrT0(IN:=FALSE);
				Cyl_BeltBottomSup.qExtendCoil	:=FALSE;
				nNextStep					:= 15;
			END_IF;		
			IF _tmrT0.Q THEN
				GVL.WarningList[3]:=TRUE;
			END_IF
			
		15:
			strText:='P15 Load-Out Delay';
			_tmrT0(IN:=TRUE,PT:=T#0.5S);
			IF _tmrT0.Q THEN
				_tmrT0(IN:=FALSE);
				IF OP.xAutoMode THEN
					nNextStep					:= 20;
					ELSE
					nNextStep					:= 50;
				END_IF;
			END_IF
		20:
				strText:='P20 Wait LoadPic Ready';
				IF M_LoadPic3.Connect= 'Seal In' THEN
					nNextStep					:= 21;
					ELSE
					Motor_BoxSealBottom_L.qRun		:=FALSE;
					Motor_BoxSealBottom_R.qRun		:=FALSE;
				END_IF
		21:
				strText:='P21 Clear Load-Out Sensor';
				_tmrT0(IN:=NOT Sen_BeltLoadOut,PT:=T#0.5S);
				Motor_BoxSealBottom_L.qRun		:=TRUE;
				Motor_BoxSealBottom_R.qRun		:=TRUE;		
				IF 	_tmrT0.Q THEN
					_tmrT0(IN:=FALSE);
					nNextStep					:= 50;
				END_IF
		50:
				strText:='P50 Done';
				nNextStep					:= 0;
	END_CASE
END_IF;

Process	:= nStep =50;

]]></ST>
      </Implementation>
    </Method>
