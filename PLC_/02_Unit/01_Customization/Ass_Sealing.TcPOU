    </Method>
    <Method Name="Initialization" Id="{c0f7d7e1-8a43-4b52-b274-e8f58634f2e0}">
      <Declaration><![CDATA[METHOD Initialization : BOOL
VAR_INPUT
END_VAR

VAR
	bConfig: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInitialScan:=TRUE;

CASE nInitiStep OF
	0:		
		_tmrT0(IN:=FALSE);
		strText:='I0 Reset';
		Motor_BoxSealBottom_L.qRun		:=FALSE;
		Motor_BoxSealBottom_R.qRun		:=FALSE;
		Cyl_BeltBottomSup.qExtendCoil	:=FALSE;		
		nInitiStep						:= 5;
	5:
	strText:='I5 Check Configuration';
	bConfig			:=TRUE;
	IF Sen_BeltLoadIn OR Sen_BeltLoadOut THEN
		bConfig			:=FALSE;
		EventLogger.eEventType		:= 4;
		EventLogger.strEventText	:= 'Sensor Error ';	
		EventLogger();					
	END_IF		
	IF NOT Motor_BoxSealBottom_R.iError OR NOT Motor_BoxSealBottom_L.iError  THEN
		bConfig			:=FALSE;
		EventLogger.eEventType		:= 4;
		EventLogger.strEventText	:= 'INV. Motor Error ';	
		EventLogger();					
	END_IF	
	
	IF bConfig THEN
		strText:='I5 Configuration Ready';
		nInitiStep	:= 20;
		ELSE
		strText:='I5 ERR Configuration Failed';
		nInitiStep	:= 50;
	END_IF
	
	
	
	
	

20:
	strText:='I20 Done';
	Initialization	:= TRUE;

50:
	strText:='I50 ERR Check Failed';

END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="NoEntry" Id="{7f044b28-0411-4954-86f6-f74c7f97a387}">
