    <Method Name="Initialization" Id="{68df2561-95fa-4481-b660-382046a2754b}">
      <Declaration><![CDATA[METHOD Initialization : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInitialScan:=TRUE;

CASE nInitiStep OF
	0:		
		strText:='StackComv Initial [Step 0] - Reset';
		Motor_Stack.qRun		:=FALSE;
		Vacm_StackUD			:=FALSE;
		Cyl_StackUD.qExtendCoil	:=FALSE;
		Bundling_yPause			:= FALSE;	
		nInitiStep				:= 5;	
	5:
		strText:='StackComv Initial [Step 5] - Wait Cylinder Origin';
		IF 	Cyl_StackUD.iOriginSensor THEN
			nInitiStep				:= 10;	
		END_IF;
	10:
			strText:='StackComv Initial [Step 10] - Done';
			Initialization	:= TRUE;
	
END_CASE;]]></ST>
      </Implementation>
    </Method>
