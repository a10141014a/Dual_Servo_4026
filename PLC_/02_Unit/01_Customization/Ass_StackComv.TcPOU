    <Method Name="Process" Id="{6448f121-61fb-4edd-a9d3-84894ee57953}">
      <Declaration><![CDATA[METHOD Process : BOOL
VAR_INPUT
	bHlatMode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bProcessScan	:= TRUE;
CASE nStep OF 
	0:
		strText:='StackComv Process [Step 0] - Start Conveyor';
		Vacm_StackUD			:=FALSE;
		Cyl_StackUD.qExtendCoil	:=FALSE;
		Motor_Stack.qRun		:=TRUE;
		nStep					:= 5;
		_tmrT0(IN:=FALSE);
		_tmrT1(IN:=FALSE);
	5:
		strText:='StackComv Process [Step 5] - Wait Stack Position';
		IF RunParameter.stack_bUsed THEN
				IF Sen_StackComvStop THEN
					Motor_Stack.qRun		:=FALSE;
					nStep					:= 9;
				END_IF
			ELSE		
		
			;
		
		
		END_IF
	9:
		strText:='StackComv Process [Step 9] - Position Delay';
		_tmrT0(IN:=TRUE,PT:=T#1S);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 10;
		END_IF		
		
	10://堆疊1
		strText:='StackComv Process [Step 10] - Extend Stack Cylinder';
		Cyl_StackUD.qExtendCoil	:= TRUE;
		_tmrT0(IN:=TRUE,PT:=RunParameter.stack_DelayTime1);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 15;
		END_IF
	15:
		strText:='StackComv Process [Step 15] - Apply Vacuum';
		Vacm_StackUD			:=TRUE;	
		_tmrT0(IN:=TRUE,PT:=T#1S);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 20;
		END_IF
	20:
		strText:='StackComv Process [Step 20] - Lift Stack';
		Cyl_StackUD.qExtendCoil	:= FALSE;		
		IF Cyl_StackUD.iOriginSensor THEN
			nStep					:= 25;
		END_IF		
	25:
		strText:='StackComv Process [Step 25] - Move Next Box';
		Motor_Stack.qRun		:=TRUE;
		IF Sen_StackComvStop THEN
			Motor_Stack.qRun		:=FALSE;
			nStep					:= 30;
		END_IF	
	30:	
		strText:='StackComv Process [Step 30] - Position Delay';
		_tmrT0(IN:=TRUE,PT:=T#1S);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 35;
		END_IF		
	
	35:		
		strText:='StackComv Process [Step 35] - Lower Stack';
		Cyl_StackUD.qExtendCoil	:= TRUE;
		_tmrT0(IN:=TRUE,PT:=RunParameter.stack_DelayTime2);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 40;
		END_IF		
	40:
		strText:='StackComv Process [Step 40] - Release Stack';
		Cyl_StackUD.qExtendCoil	:= FALSE;
		Vacm_StackUD			:=FALSE;
		_tmrT0(IN:=TRUE,PT:=T#0.5S);
		IF _tmrT0.Q THEN
			_tmrT0(IN:=FALSE);
			nStep					:= 45;
		END_IF						
	45:
		strText:='StackComv Process [Step 45] - Clear Stack Position';
		Motor_Stack.qRun		:=TRUE;
		IF NOT Sen_StackComvStop THEN
			nStep					:=0;
		END_IF	
	
	
	
	
END_CASE]]></ST>
      </Implementation>
    </Method>
