    <Method Name="Initialization" Id="{590597e0-2263-4555-812b-e1b41a0161a3}">
      <Declaration><![CDATA[METHOD Initialization : BOOL
VAR_INPUT
END_VAR

VAR
	bConfig: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
_tmrT0(IN:=TRUE,PT:=T#0.2S);
LoadCell.i_bCmd_Tara:= NOT _tmrT0.Q  ;
Initialization	:= AssRoller.Initialization() AND _tmrT0.Q ;
SamplingWeight	:=0;
Cyl_NGPurge.qExtendCoil	:= FALSE;
Roller_Purge.qRun:= FALSE;
Motor_shock.qRun	:= FALSE;
Motor_shock.qSign	:= FALSE;
Cyl_ShockStop.qExtendCoil:= FALSE;
*)

_bInitialScan:=TRUE;

CASE nInitiStep OF
	0:		
		LoadCell.GetTara();
		_tmrT0(IN:=FALSE);
		strText:='UnloadNG Initial [Step 0] - Reset';
		Cyl_NGPurge.qExtendCoil		:= FALSE;
		Roller_Purge.qRun			:= FALSE;
		Motor_shock.qRun			:= FALSE;
		Motor_shock.qSign			:= FALSE;
		Cyl_ShockStop.qExtendCoil	:= FALSE;		
		nInitiStep						:= 5;
	5:
		strText:='UnloadNG Initial [Step 5] - Check Configuration';
		bConfig			:=TRUE;
		IF Sen_TFLoadIn THEN
			bConfig			:=FALSE;
			EventLogger.eEventType		:= 3;
			EventLogger.strEventText	:= 'TF Sensor Error ';	
			EventLogger();					
		END_IF		
			
		IF bConfig THEN
			nInitiStep	:= 10;
			strText:='UnloadNG Initial [Step 5] - Configuration Ready';
			ELSE
			strText:='UnloadNG Initial Error [Step 5] - Configuration Failed';
			nInitiStep	:= 50;
		END_IF	
	10:
		strText:='UnloadNG Initial [Step 10] - Initialize Roller';
		IF AssRoller.Initialization() THEN
			nInitiStep	:= 20;
		END_IF;		
	20:
		strText:='UnloadNG Initial [Step 20] - Done';
		Initialization	:= TRUE;
	50:
		strText:='UnloadNG Initial Error [Step 50] - Check Failed';
	
END_CASE;
	]]></ST>
      </Implementation>
    </Method>
