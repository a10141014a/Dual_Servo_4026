    <Method Name="FB_init" Id="{6ee37c47-e433-467e-9dd3-e44e9eaf1d46}">
      <Declaration><![CDATA[
METHOD FB_init : BOOL
VAR_INPUT
	(* if TRUE, the retain variables are initialized (warm start / cold start)*)
	bInitRetains	: BOOL;
	(* if TRUE, the instance afterwards gets moved into the copy code (online change)*)
	bInCopyCode	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="HaltStepContiune" Id="{d396cd10-9f63-4417-8480-d1cd25505f17}">
      <Declaration><![CDATA[METHOD HaltStepContiune : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialization" Id="{66ca2f64-7fd9-492e-bcfe-07dd858ba740}">
      <Declaration><![CDATA[METHOD Initialization : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInitialScan	:= TRUE;
// Bound the add/reset/enable handshake; a timeout follows the existing error path.
tmrGroupInitial(IN:=(nInitiStep>=58) AND (nInitiStep<=62), PT:=T#10S);
IF tmrGroupInitial.Q THEN
	nInitiStep:=nInitiStep+900;
END_IF
CASE nInitiStep OF
0:
		nInitialGroupErrorId:=0;
		nInitialCommandErrorId:=0;
		RB_CS_PickIO.cmd_bPartInPos	:=FALSE;
		fbMC_GearOut.Execute:=FALSE;
		fbMC_MoveAbsoluteCA_Left.Execute	:= FALSE;
		fbMC_MoveAbsoluteCA_Right.Execute	:= FALSE;
		MC_TouchProbeFly.Execute:=FALSE;
		MC_TouchProbeDual1.Execute:=FALSE;
		MC_TouchProbeDual2.Execute:=FALSE;
		MC_AbortTrigger1.Execute:= FALSE;
		MC_AbortTrigger2.Execute:= FALSE;
		MC_SetPositionLeft.Execute:= FALSE;
		MC_SetPositionRight.Execute:= FALSE;
		MC_SetPositionCon.Execute:= FALSE;
		L_Home.Execute:= FALSE;
		R_Home.Execute:= FALSE;
		MC_GroupReset.Execute:= FALSE;
		fbMC_GearOut.Execute:= FALSE;
		fbMC_GearIN.Execute:= FALSE;
		fbMC_GroupDisable.Execute:= FALSE;
		fbMC_UngroupAllAxes.Execute:= FALSE;
		fbAddAxis[1].Execute:= FALSE;
		fbAddAxis[2].Execute:= FALSE;
		fbMC_GroupEnable.Execute:= FALSE;
		fbMC_GroupDisable.Execute:= FALSE;
		fbMC_UngroupAllAxes.Execute:= FALSE;
		bDual1First:=FALSE;
		bDual2First:=FALSE;
		bDual1Done:=FALSE;
		bDual2Done:=FALSE;
		tmrT1(IN:=FALSE);
		_tmrT0(IN:=TRUE,PT:=T#0.1S);
		nStopStep			:= 0;
		strText:='Initial [Step 0] - Reset';
		IF _tmrT0.Q THEN
			ClearData();
			_tmrT0(IN:=FALSE);
			nInitiStep	:= 1;
		END_IF;

1: // Static: cancel according to the mode captured at Initialization entry
	strText:='Initial [Step 1] - Cancel Touch Probes';
	nInitiStep:=5;
	// Continuous: Execute=FALSE. Single: Execute=FALSE plus MC_AbortTrigger.
	IF MC_TouchProbeDual1.Busy OR MC_TouchProbeDual2.Busy THEN
		MC_AbortTrigger1.Execute:= TRUE;
		MC_AbortTrigger2.Execute:= TRUE;
		nInitiStep:=2;		
	END_IF
2:
	strText:='Initial [Step 2] - Wait Probe Abort';
	IF 	MC_AbortTrigger1.Done AND MC_AbortTrigger2.Done THEN
		nInitiStep:=3;
	END_IF


3: // Static: write Single only after the previous mode has been cancelled
	strText:='Initial [Step 3] - Set Probe Single Mode';
	MC_TouchProbeDual1.Execute:=FALSE;
	MC_TouchProbeDual2.Execute:=FALSE;
	MC_AbortTrigger1.Execute:=FALSE;
	MC_AbortTrigger2.Execute:=FALSE;
	TouchTriggerDual1.Mode:=TOUCHPROBEMODE_SINGLE;
	TouchTriggerDual2.Mode:=TOUCHPROBEMODE_SINGLE;
	nInitiStep:=5;

5: // Static: keep Single mode stable for one Instance scan
	strText:='Initial [Step 5] - Apply Probe Mode';
	TouchTriggerDual1.Mode:=TOUCHPROBEMODE_SINGLE;
	TouchTriggerDual2.Mode:=TOUCHPROBEMODE_SINGLE;
	nInitiStep:=10;

10: // Static: reset, power on and stop all axes
	strText:='Initial [Step 10] - Prepare Axes';
	TouchTriggerDual1.Mode:=TOUCHPROBEMODE_SINGLE;
	TouchTriggerDual2.Mode:=TOUCHPROBEMODE_SINGLE;
	_tmrT0(IN:= NOT _tmrT0.Q ,PT:= T#10S);
	IF Axis_DualServo1.Status.Error THEN
		Axis_DualServo1.Reset();
	ELSIF Axis_DualServo1.Status.Disabled THEN
		Axis_DualServo1.ServoOn();
	ELSIF Axis_DualServo1.Status.Moving THEN
		Axis_DualServo1.Stop();
	END_IF
	IF Axis_DualServo2.Status.Error THEN
		Axis_DualServo2.Reset();
	ELSIF Axis_DualServo2.Status.Disabled THEN
		Axis_DualServo2.ServoOn();
	ELSIF Axis_DualServo2.Status.Moving THEN
		Axis_DualServo2.Stop();
	END_IF
	IF Axis_FlyIn.Status.Error THEN
		Axis_FlyIn.Reset();
	ELSIF Axis_FlyIn.Status.Disabled THEN
		Axis_FlyIn.ServoOn();
	ELSIF Axis_FlyIn.Status.Moving THEN
		Axis_FlyIn.Stop();
	END_IF
	IF NOT Axis_DualServo1.Status.Error AND NOT Axis_DualServo1.Status.Disabled AND Axis_DualServo1.Status.NotMoving
	AND NOT Axis_DualServo2.Status.Error AND NOT Axis_DualServo2.Status.Disabled AND Axis_DualServo2.Status.NotMoving
	AND NOT Axis_FlyIn.Status.Error AND NOT Axis_FlyIn.Status.Disabled AND Axis_FlyIn.Status.NotMoving THEN
		_tmrT0(IN:=FALSE);
		nInitiStep	:= 20;
	END_IF
	IF _tmrT0.Q THEN
		_tmrT0(IN:=FALSE);
		nInitiStep	:=nInitiStep+ 900;
	END_IF

20: // Static: disable DualGroupRef if axes are assigned
	strText:='Initial [Step 20] - Disable Axis Group';
	IF DualGroupRef.NcToPlc.CA.Common.GroupAxesCount=0 THEN
		fbMC_GroupDisable.Execute:=FALSE;
		nInitiStep:=40;
	ELSE
		fbMC_GroupDisable.Execute:=TRUE;
		IF fbMC_GroupDisable.Done THEN
			nInitiStep:=25;
		ELSIF fbMC_GroupDisable.Error THEN
			nInitiStep:=nInitiStep+900;
		END_IF
	END_IF

25: // Static: remove all axes from DualGroupRef
	strText:='Initial [Step 25] - Ungroup Axes';
	fbMC_GroupDisable.Execute:=FALSE;
	fbMC_UngroupAllAxes.Execute:=TRUE;
	IF fbMC_UngroupAllAxes.Done AND DualGroupRef.NcToPlc.CA.Common.GroupAxesCount=0 THEN
		nInitiStep:=30;
		IF Axis_DualServo1.Status.Stopping THEN
			nInitiStep:=26;
		END_IF
	ELSIF fbMC_UngroupAllAxes.Error THEN
		nInitiStep:=nInitiStep+900;
	END_IF
26:
	strText:='Initial [Step 26] - Reset Dual Servo 1';
	HardwareIO.Axis_DualServo1.Reset();
	nInitiStep:=30;
30: // Static: clear the ungroup command
	strText:='Initial [Step 30] - Clear Ungroup Command';
	fbMC_UngroupAllAxes.Execute:=FALSE;
	nInitiStep:=40;

40: // Static: keep an existing GearIn or create it
	strText:='Initial [Step 40] - Gear In';
	IF Axis_DualServo2.Status.Coupled THEN
		fbMC_GearIn.Execute:=FALSE;
		nInitiStep:=50;
	ELSE
		fbMC_GearIn.Execute:=TRUE;
		IF fbMC_GearIn.InGear OR Axis_DualServo2.Status.Coupled THEN
			fbMC_GearIn.Execute:=FALSE;
			nInitiStep:=50;
		ELSIF fbMC_GearIn.Error THEN
			fbMC_GearIn.Execute:=FALSE;
			nInitiStep:=nInitiStep+900;
		END_IF
	END_IF

50: // Dynamic: arm both external latch inputs
	TouchTriggerDual1.Mode:=TOUCHPROBEMODE_SINGLE;
	TouchTriggerDual2.Mode:=TOUCHPROBEMODE_SINGLE;
	MC_AbortTrigger1.Execute:=FALSE;
	MC_AbortTrigger2.Execute:=FALSE;
	tmrT1(IN:=FALSE);
	bDual1First:=FALSE;
	bDual2First:=FALSE;
	bDual1Done:=FALSE;
	bDual2Done:=FALSE;
	strText:='Initial [Step 50] - Arm Touch Probes';
	MC_TouchProbeDual1.Execute:=TRUE;
	MC_TouchProbeDual2.Execute:=TRUE;
	// Done is not expected before motion starts; both probes must be armed (Busy).
	IF MC_TouchProbeDual1.Busy AND MC_TouchProbeDual2.Busy THEN
		nInitiStep:=51;
	ELSIF MC_TouchProbeDual1.Error OR MC_TouchProbeDual2.Error THEN
		nInitiStep:=nInitiStep+900;
	END_IF

51: // Dynamic: verify coupling before motion
	strText:='Initial [Step 51] - Verify Coupling';
	IF Axis_DualServo2.Status.Coupled THEN
		nInitiStep:=52;
	ELSE
		nInitiStep:=nInitiStep+900;
	END_IF

52: // Dynamic: move master and capture both latch positions
	strText:='Initial [Step 52] - Capture Latch Positions';
	tmrT1(IN:=TRUE,PT:=T#10S);
	Axis_DualServo1.MoveVelocity(500,1);
	IF MC_TouchProbeDual1.Done AND NOT bDual1Done THEN
		LatchDual1Pos:=MC_TouchProbeDual1.RecordedData.RecordedPosition;
		bDual1Done:=TRUE;
		IF NOT bDual2First THEN bDual1First:=TRUE; END_IF
	END_IF
	IF MC_TouchProbeDual2.Done AND NOT bDual2Done THEN
		LatchDual2Pos:=MC_TouchProbeDual2.RecordedData.RecordedPosition;
		bDual2Done:=TRUE;
		IF NOT bDual1First THEN bDual2First:=TRUE; END_IF
	END_IF
	IF bDual1Done AND bDual2Done THEN
		tmrT1(IN:=FALSE);
		MC_TouchProbeDual1.Execute:=FALSE;
		MC_TouchProbeDual2.Execute:=FALSE;
		nInitiStep:=53;
	ELSIF MC_TouchProbeDual1.Error OR MC_TouchProbeDual2.Error THEN
		tmrT1(IN:=FALSE);
		nInitiStep:=nInitiStep+900;
	ELSIF tmrT1.Q THEN
		tmrT1(IN:=FALSE);
		nInitiStep:=nInitiStep+900;
	END_IF

53: // Dynamic: stop the master and coupled slave
	MC_AbortTrigger1.Execute:=FALSE;
	MC_AbortTrigger2.Execute:=FALSE;
	strText:='Initial [Step 53] - Stop Dual Servos';
	IF Axis_DualServo1.Status.Moving THEN
		Axis_DualServo1.Stop();
	END_IF
	IF Axis_DualServo1.Status.NotMoving AND Axis_DualServo2.Status.NotMoving THEN
		nInitiStep:=54;
	END_IF

54: // Dynamic: release electronic gearing after standstill
	strText:='Initial [Step 54] - Gear Out';
	IF Axis_DualServo2.Status.Coupled THEN
		fbMC_GearOut.Execute:=TRUE;
	ELSE
		fbMC_GearOut.Execute:=FALSE;
		nInitiStep:=55;
	END_IF
	IF fbMC_GearOut.Error THEN
		fbMC_GearOut.Execute:=FALSE;
		nInitiStep:=nInitiStep+900;
	END_IF

55: // Dynamic: set coordinates from latched positions
	strText:='Initial [Step 55] - Set Axis Positions';
	MC_SetPositionLeft.Position:=Axis_DualServo1.NcToPlc.ActPos-LatchDual1Pos-Setting_Dual1_ORG_Offset;
	MC_SetPositionRight.Position:=Axis_DualServo2.NcToPlc.ActPos-LatchDual2Pos-Setting_Dual2_ORG_Offset;
	MC_SetPositionLeft.Execute:=TRUE;
	MC_SetPositionRight.Execute:=TRUE;
	MC_SetPositionCon.Position:=0;
	MC_SetPositionCon.Execute:=TRUE;
	IF MC_SetPositionLeft.Done AND MC_SetPositionRight.Done AND MC_SetPositionCon.Done THEN
		nInitiStep:=56;
	ELSIF MC_SetPositionLeft.Error OR MC_SetPositionRight.Error OR MC_SetPositionCon.Error THEN
		nInitiStep:=nInitiStep+900;
	END_IF

56: // Dynamic: force calibration home on both dual-servo axes
	strText:='Initial [Step 56] - Calibrate Dual Servos';
	MC_SetPositionLeft.Execute:=FALSE;
	MC_SetPositionRight.Execute:=FALSE;
	MC_SetPositionCon.Execute:=FALSE;
	L_Home.Execute:=TRUE;
	R_Home.Execute:=TRUE;
	IF L_Home.Done AND R_Home.Done THEN
		nInitiStep:=57;
	ELSIF L_Home.Error OR R_Home.Error THEN
		nInitiStep:=nInitiStep+900;
	END_IF

57: // Dynamic: add is allowed only when DualGroupRef is empty
	strText:='Initial [Step 57] - Verify Empty Group';
	L_Home.Execute:=FALSE;
	R_Home.Execute:=FALSE;
	MC_GroupReset.Execute:=FALSE;
	fbMC_GroupDisable.Execute:=FALSE;
	fbMC_UngroupAllAxes.Execute:=FALSE;
	fbAddAxis[1].Execute:=FALSE;
	fbAddAxis[2].Execute:=FALSE;
	fbMC_GroupEnable.Execute:=FALSE;
	IF DualGroupRef.NcToPlc.Common.GroupAxesCount=0 THEN
		fbAddAxis[1].IdentInGroup:=UDINT_TO_IDENTINGROUP(1); // X-Axis
		fbAddAxis[2].IdentInGroup:=UDINT_TO_IDENTINGROUP(2); // Y-Axis
		nInitiStep:=58;
	ELSE
		nInitiStep:=nInitiStep+900;
	END_IF

58: // Dynamic: add both axes to DualGroupRef
	strText:='Initial [Step 58] - Add Axes to Group';
	fbAddAxis[1].Execute:=TRUE;
	fbAddAxis[2].Execute:=TRUE;
	IF fbAddAxis[1].Error OR fbAddAxis[2].Error THEN
		IF fbAddAxis[1].Error THEN
			nInitialCommandErrorId:=fbAddAxis[1].ErrorId;
		ELSE
			nInitialCommandErrorId:=fbAddAxis[2].ErrorId;
		END_IF
		fbAddAxis[1].Execute:=FALSE;
		fbAddAxis[2].Execute:=FALSE;
		nInitiStep:=nInitiStep+900;
	ELSIF fbAddAxis[1].Done AND fbAddAxis[2].Done THEN
		fbAddAxis[1].Execute:=FALSE;
		fbAddAxis[2].Execute:=FALSE;
		nInitiStep:=59;
	END_IF

59: // Reset a latched group error once, after both stationary axes were added.
	strText:='Initial [Step 59] - Reset Axis Group';
	fbMC_GroupEnable.Execute:=FALSE;
	IF MC_GroupReset.Execute
	OR DualGroupRef.NcToPlc.Common.GroupStatus.State=mcGroupStateErrorStop
	OR DualGroupRef.NcToPlc.Common.GroupErrorId<>0 THEN
		IF NOT MC_GroupReset.Execute THEN
			nInitialGroupErrorId:=DualGroupRef.NcToPlc.Common.GroupErrorId;
		END_IF
		MC_GroupReset.Execute:=TRUE;
		IF MC_GroupReset.Error THEN
			nInitialCommandErrorId:=MC_GroupReset.ErrorId;
			MC_GroupReset.Execute:=FALSE;
			nInitiStep:=959;
		ELSIF MC_GroupReset.Done THEN
			MC_GroupReset.Execute:=FALSE;
			nInitiStep:=60;
		END_IF
	ELSE
		nInitiStep:=60;
	END_IF

60: // Wait for cyclic NC feedback; do not retry reset if the fault persists.
	strText:='Initial [Step 60] - Verify Group Ready';
	MC_GroupReset.Execute:=FALSE;
	fbMC_GroupEnable.Execute:=FALSE;
	IF DualGroupRef.NcToPlc.Common.GroupAxesCount=2
	AND DualGroupRef.NcToPlc.Common.GroupErrorId=0 THEN
		IF DualGroupRef.NcToPlc.Common.GroupStatus.State=mcGroupStateDisabled THEN
			nInitiStep:=61;
		ELSIF DualGroupRef.NcToPlc.Common.GroupStatus.State=mcGroupStateStandby THEN
			// Reset can return an already-enabled group to Standby.
			nInitiStep:=62;
		END_IF
	END_IF

61: // Dynamic: enable the rebuilt group
	strText:='Initial [Step 61] - Enable Axis Group';
	// Check the state at the rising edge, not while an accepted command is busy.
	IF NOT fbMC_GroupEnable.Execute THEN
		IF DualGroupRef.NcToPlc.Common.GroupAxesCount=2
		AND DualGroupRef.NcToPlc.Common.GroupErrorId=0
		AND DualGroupRef.NcToPlc.Common.GroupStatus.State=mcGroupStateDisabled THEN
			fbMC_GroupEnable.Execute:=TRUE;
		ELSE
			nInitiStep:=961;
		END_IF
	END_IF
	IF fbMC_GroupEnable.Error THEN
		nInitialCommandErrorId:=fbMC_GroupEnable.ErrorId;
		fbMC_GroupEnable.Execute:=FALSE;
		nInitiStep:=961;
	ELSIF fbMC_GroupEnable.Done THEN
		fbMC_GroupEnable.Execute:=FALSE;
		nInitiStep:=62;
	END_IF

62: // Dynamic: verify group membership and Standby state
	strText:='Initial [Step 62] - Verify Axis Group';
	IF DualGroupRef.NcToPlc.Common.GroupAxesCount=2
	AND DualGroupRef.NcToPlc.Common.GroupErrorId=0
	AND DualGroupRef.NcToPlc.Common.GroupStatus.State=mcGroupStateStandby THEN
		nInitiStep:=63;
	END_IF

63:
	strText:='Initial [Step 63] - Done';
	Initialization:=TRUE;

900..999:
	IF DualGroupRef.NcToPlc.Common.GroupErrorId<>0 THEN
		nInitialGroupErrorId:=DualGroupRef.NcToPlc.Common.GroupErrorId;
	END_IF
	MC_GroupReset.Execute:=FALSE;
	fbMC_GroupEnable.Execute:=FALSE;
	fbAddAxis[1].Execute:=FALSE;
	fbAddAxis[2].Execute:=FALSE;
	fbMC_GroupDisable.Execute:=FALSE;
	fbMC_UngroupAllAxes.Execute:=FALSE;
	tmrGroupInitial(IN:=FALSE);
	MC_TouchProbeDual1.Execute:=FALSE;
	MC_TouchProbeDual2.Execute:=FALSE;
	// A Single-mode cycle must be cancelled with MC_AbortTrigger before leaving Initialization.
	MC_AbortTrigger1.Execute:=(TouchTriggerDual1.Mode=TOUCHPROBEMODE_SINGLE) AND NOT MC_AbortTrigger1.Done AND NOT MC_AbortTrigger1.Error;
	MC_AbortTrigger2.Execute:=(TouchTriggerDual2.Mode=TOUCHPROBEMODE_SINGLE) AND NOT MC_AbortTrigger2.Done AND NOT MC_AbortTrigger2.Error;
	fbMC_GearIn.Execute:=FALSE;
	fbMC_GearOut.Execute:=FALSE;
	IF Axis_DualServo1.Status.Moving THEN
		Axis_DualServo1.Stop();
	END_IF
	strText:=CONCAT(CONCAT('Initial Error [Step ',INT_TO_STRING(nInitiStep-900)),'] - Stop');
	WarningList[40]	:=TRUE;
	nInitiStep:=nInitiStep+100;
	(* Legacy initialization sequence retained as reference only.

20:	//感測sensor
	// Legacy latch motion (unreachable)
	Axis_DualServo1.MoveVelocity(500,0);
	IF MC_TouchProbeDual1.Done AND NOT bDual1Done THEN
		LatchDual1Pos	:=  MC_TouchProbeDual1.RecordedData.RecordedPosition;
		bDual1Done	:= TRUE;
		IF NOT bDual2First THEN
			bDual1First	:= TRUE;
		END_IF
	END_IF

	IF MC_TouchProbeDual2.Done AND NOT bDual2Done THEN
		LatchDual2Pos	:=  MC_TouchProbeDual2.RecordedData.RecordedPosition;
		bDual2Done	:= TRUE;
		IF NOT bDual1First THEN
			bDual2First	:= TRUE;
		END_IF
	END_IF

	IF bDual1Done AND bDual2Done THEN
		MC_TouchProbeDual1.Execute:=FALSE;
		MC_TouchProbeDual2.Execute:=FALSE;
		nInitiStep:=25;
	END_IF
25:
	strText:='ORG : GetPosition ';
	IF Axis_DualServo1.Status.MotionState = MC_AXISSTATE_STANDSTILL THEN
		fbMC_GearOut.Execute:=TRUE;
		IF NOT Axis_DualServo2.Status.Coupled THEN
			fbMC_GearOut.Execute:=FALSE;
			nInitiStep		:= nInitiStep+5;
		END_IF;
	END_IF
30:

	MC_SetPositionLeft.Position	:= Axis_DualServo1.NcToPlc.ActPos - LatchDual1Pos- Setting_Dual1_ORG_Offset
 ;
	MC_SetPositionRight.Position:= Axis_DualServo2.NcToPlc.ActPos - LatchDual2Pos- Setting_Dual2_ORG_Offset;
	MC_SetPositionLeft.Execute:= TRUE;
	MC_SetPositionRight.Execute:= TRUE;
	MC_SetPositionCon.Execute:= TRUE;
	IF MC_SetPositionLeft.Done AND MC_SetPositionRight.Done AND MC_SetPositionCon.Done THEN
		nInitiStep		:= nInitiStep+1;
	END_IF

31:
	MC_SetPositionLeft.Execute:= FALSE;
	MC_SetPositionRight.Execute:= FALSE;
	MC_SetPositionCon.Execute:= FALSE;
	L_Home.Execute:= TRUE;
	R_Home.Execute:= TRUE;
	IF L_Home.Done AND R_Home.Done THEN
		nInitiStep		:= 35;
	END_IF
35:
	L_Home.Execute:= FALSE;
	R_Home.Execute:= FALSE;
	MC_GroupReset.Execute:= TRUE;
	IF MC_GroupReset.Done THEN
		nInitiStep		:= nInitiStep +1 ;
	END_IF;


36:
	MC_GroupReset.Execute:= FALSE;
	// Legacy group rebuild was moved to active Initialization steps 57..62.
	nInitiStep		:= 40;
40:
	// Legacy event logger block
	EventLogger.eEventType		:= 1;
	EventLogger.strEventText	:= 'DualServo ORG Done';
	EventLogger();
	nInitiStep		:= nInitiStep+5;
45:
	strText:='ORG : Done ';
	Initialization:= TRUE;


99..199:
;
	*)
END_CASE;

]]></ST>
      </Implementation>
    </Method>
    <Action Name="Instance" Id="{bbb900a2-dafe-4b2b-b3e8-eb3ce6527e01}">
      <Implementation>
        <ST><![CDATA[TouchTriggerFly.EncoderID  := Axis_FlyIn.DriveAddress.NcEncoderId ;
TouchTriggerFly.TouchProbe := TouchProbe1 ;
TouchTriggerFly.SignalSource:= SignalSource_Input1;
TouchTriggerFly.Edge:=RisingEdge;
TouchTriggerFly.Mode:= TOUCHPROBEMODE_CONTINOUS  ;
TouchTriggerDual1.EncoderID  := Axis_DualServo1.DriveAddress.NcEncoderId ;
TouchTriggerDual1.TouchProbe := TouchProbe1 ;
TouchTriggerDual1.SignalSource:= SignalSource_Input1;
TouchTriggerDual1.Edge:=RisingEdge;
TouchTriggerDual2.EncoderID  := Axis_DualServo2.DriveAddress.NcEncoderId ;
TouchTriggerDual2.TouchProbe := TouchProbe1 ;
TouchTriggerDual2.SignalSource:= SignalSource_Input1;
TouchTriggerDual2.Edge		:=RisingEdge;
fbMC_GearOut(Slave:=Axis_DualServo2);
fbMC_GearIn(Master:=Axis_DualServo1, Slave:=Axis_DualServo2);
MC_SetPositionLeft(Axis:=Axis_DualServo1);
MC_SetPositionRight(Axis:=Axis_DualServo2);
MC_SetPositionCon(Axis:=Axis_FlyIn);
L_Home(Axis:=Axis_DualServo1);
R_Home(Axis:=Axis_DualServo2);
MC_GroupReset(AxesGroup:=DualGroupRef);
MC_AbortTrigger1(Axis:=Axis_DualServo1, TriggerInput:=TouchTriggerDual1);
MC_AbortTrigger2(Axis:=Axis_DualServo2, TriggerInput:=TouchTriggerDual2);

MC_TouchProbeFly(Axis:= Axis_FlyIn, TriggerInput:=TouchTriggerFly);
MC_TouchProbeDual1(	Axis:= Axis_DualServo1,TriggerInput:=TouchTriggerDual1);
MC_TouchProbeDual2(	Axis:= Axis_DualServo2,TriggerInput:=TouchTriggerDual2);
fbAddAxis[1](AxesGroup:=DualGroupRef, Axis:=Axis_DualServo1);
fbAddAxis[2](AxesGroup:=DualGroupRef, Axis:=Axis_DualServo2);
fbMC_MoveAbsoluteCA_Left(Axis:= Axis_DualServo1,Gap:= RunParameter.Dual_Gap+RunParameter.Dual_Length ,Direction:=mcDirectionPositive);
fbMC_MoveAbsoluteCA_Right(Axis:= Axis_DualServo2,Gap:= RunParameter.Dual_Gap+RunParameter.Dual_Length,Direction:=mcDirectionPositive);
fbMC_GroupEnable(AxesGroup:= DualGroupRef);
fbMC_GroupDisable(AxesGroup:= DualGroupRef);
fbMC_UngroupAllAxes(AxesGroup:= DualGroupRef);

//
IF MC_TouchProbeDual1.Error  THEN
	MC_TouchProbeDual1.Execute :=FALSE;
END_IF
IF MC_TouchProbeDual2.Error  THEN
	MC_TouchProbeDual2.Execute :=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Property Name="NoEntry" Id="{ee1e0b30-2d33-44f9-a01f-81cdbe28cdfd}">
      <Declaration><![CDATA[PROPERTY NoEntry : BOOL
]]></Declaration>
      <Get Name="Get" Id="{48bd4329-6519-4a4c-a929-2051fe882d4e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Pause" Id="{a53f13b1-1f66-4e70-9019-4c296e85f26d}">
      <Declaration><![CDATA[
METHOD Pause : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Process" Id="{24579088-a2ed-4985-87b7-ad0986148b13}">
      <Declaration><![CDATA[METHOD Process : BOOL
VAR_INPUT
	bHlatMode	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bProcessScan	:= TRUE;
TouchTriggerDual1.Mode		:= TOUCHPROBEMODE_CONTINOUS ;
TouchTriggerDual2.Mode		:= TOUCHPROBEMODE_CONTINOUS ;
fRampTime					:= RunParameter.Fly_Disdance	/RunParameter.Fly_Velo;



CASE  nStep OF
	0:
		wSlot	:=0;

		MC_SetPositionCon.Execute:=FALSE;
		fbMC_StopFly(Axis:= Axis_FlyIn,Execute:= FALSE);
		IF DualGroupRef.NcToPlc.Common.GroupStatus.State = mcGroupStateStandby AND DualGroupRef.NcToPlc.Common.GroupAxesCount = 2 THEN
			OP.bCycleStep	:= FALSE;
			ClearData();
			nStep	:= 1;
		END_IF
	1:
		MC_SetPositionCon.Position:=0;
		MC_SetPositionCon.Execute:=TRUE;
		IF 	MC_SetPositionCon.Done THEN
			MC_TouchProbeFly.Execute	:= TRUE;
			nStep	:= 2;
		END_IF
	2:
		tmrFlyinDef(IN:=FALSE);
		IF MC_TouchProbeFly.Busy THEN
			_FlyInCalibrationPos	:= MC_TouchProbeFly.RecordedData.RecordedPosition;
			nStep	:=5;
		END_IF;
	5:
		strText	:= 'AutoFeed';
		IF NOT bPause THEN
			strText	:= 'Pause';
			Axis_FlyIn.MoveVelocity(RunParameter.Fly_Velo,1);
		END_IF;
		//feedin def
		tmrFlyinDef(PT:=T#0.2S);
		IF tmrFlyinDef.IN THEN
			_FlyInCalibrationPos	:= MC_TouchProbeFly.RecordedData.RecordedPosition;
		END_IF
		IF tmrFlyinDef.Q THEN
			tmrFlyinDef.IN	:= FALSE;
		END_IF
		IF _FlyInCalibrationPos <>  MC_TouchProbeFly.RecordedData.RecordedPosition THEN
			tmrFlyinDef.IN	:= TRUE;
			_FlyInCalibrationPos	:= MC_TouchProbeFly.RecordedData.RecordedPosition;
			ResInData(_FlyInCalibrationPos);
		END_IF


		//auto test tool
		IF Hmi_bDualFeedTest THEN
			ResInData(Axis_FlyIn.NcToPlc.ActPos);
			Hmi_bDualFeedTest	:=FALSE;
		END_IF

		tmrAuto(IN:=Hmi_bDualAutoTest AND NOT tmrAuto.Q AND Motor_LoadIn.qRun,PT:=Hmi_bDualAutoTestTime );

		IF  tmrAuto.q AND ConvQty < 1 THEN
			ResInData(Axis_FlyIn.NcToPlc.ActPos);
		END_IF
		//////////////////////

		IF OP.bStop_Sign THEN
			fbMC_StopFly.Execute:= TRUE;
			nStep:= 10;
		END_IF

		IF slot[1].ScanIn AND NOT slot[1].LoadIn THEN
			IF  Axis_FlyIn.NcToPlc.ActPos>slot[1].GearInPosition THEN
				slot[1].LoadIn	:=TRUE;
			END_IF
		END_IF


	10:
		;
END_CASE

CASE nLeftStep OF
	0:
		strLeftText:='Para Set';
		MC_TouchProbeDual1.Execute:= TRUE;
		IF MC_TouchProbeDual1.Busy THEN
			nLeftStep	:=1;
		END_IF;


	1:
			strLeftText:='P1 moving';
			fbMC_MoveAbsoluteCA_Left.Execute	:=TRUE;
			fbMC_MoveAbsoluteCA_Left.Position	:= RunParameter.Dual_LoadInPos;
			fbMC_MoveAbsoluteCA_Left.Velocity	:=RunParameter.Dual_Velo;
			fbMC_MoveAbsoluteCA_Left.Acceleration	:= 15000;
			fbMC_MoveAbsoluteCA_Left.Deceleration	:= 15000;
			fbMC_MoveAbsoluteCA_Left.Jerk			:= 50000;
			LeftLoadinQty	:=0;
			nLeftStep		:= 5;

	5:
		IF Axis_DualServo1.Status.NotMoving THEN
			strLeftText:='P1 Coupled';
			ELSE
			strLeftText:='P1 moving';
		END_IF;

		IF fbMC_MoveAbsoluteCA_Left.Done THEN
			strLeftText:='P1 Pos';
			fbMC_MoveAbsoluteCA_Left.Execute	:= FALSE;
			nLeftStep	:=10;
		END_IF
	10:
		strLeftText:='P1 Pos';
		strLeftText	:= CONCAT(strLeftText,UINT_TO_STRING(LeftLoadinQty));
		IF slot[1].LoadIn THEN
			LeftLoadinQty	:= 	LeftLoadinQty+1;
			ResOut();
			IF LeftLoadinQty < RunParameter.Dual_LoadInQty[wSlot] THEN
				strLeftText:='P1 Next Pos';
				strLeftText	:= CONCAT(strLeftText,UINT_TO_STRING(LeftLoadinQty));
				fbMC_MoveAbsoluteCA_Left.Execute	:= TRUE;
				fbMC_MoveAbsoluteCA_Left.Position	:= fbMC_MoveAbsoluteCA_Left.Position + RunParameter.Dual_ModulePitchLength;
				fbMC_MoveAbsoluteCA_Left.Velocity	:= 1500;
				//fbMC_MoveAbsoluteCA_Left.Velocity	:= RunParameter.Dual_ModulePitchLength / (fRampTime*0.5);
				nLeftStep	:= 5;
				ELSE
				wSlot								:= wSlot + 1;
				IF RunParameter.Dual_LoadInQty[wSlot] = 0 THEN
					wSlot	:= 0;
				END_IF
				fbMC_MoveAbsoluteCA_Left.Execute		:= TRUE;
				fbMC_MoveAbsoluteCA_Left.Position		:= RunParameter.Dual_LoadOutPos;
				fbMC_MoveAbsoluteCA_Left.Velocity		:= RunParameter.Dual_Velo;
				fbMC_MoveAbsoluteCA_Left.Acceleration	:= Parameter_PERSISTENT.Setting_DualServoAcc;
				fbMC_MoveAbsoluteCA_Left.Deceleration	:= Parameter_PERSISTENT.Setting_DualServoDec;
				fbMC_MoveAbsoluteCA_Left.Jerk			:= Parameter_PERSISTENT.Setting_DualServoJerk;
				strLeftText:='P2 moving';
				nLeftStep	:= 20;
			END_IF;
		END_IF



	20://裝完
		IF Axis_DualServo1.Status.NotMoving THEN
			strLeftText:='P2 Coupled';
			ELSE
			strLeftText:='P2 moving';
		END_IF

		IF fbMC_MoveAbsoluteCA_Left.Done THEN
			strLeftText:='P2 Pos Call RB';
			fbMC_MoveAbsoluteCA_Left.Execute	:= FALSE;
			nLeftStep	:= 24;
			RB_CS_PickIO.cmd_bPartInPos	:= TRUE;

		END_IF
	24://RB輸出通知
		IF RB_CS_PickIO.fb_bPackFinish	THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			nLeftStep	:= 25;
		END_IF
			IF Hmi_bPickFeedTest THEN
				RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
				Hmi_bPickFeedTest			:=FALSE;
				nLeftStep					:= 29;
			END_IF
	25:
		IF NOT RB_CS_PickIO.fb_bPackFinish	THEN
			nLeftStep	:= 29;
		END_IF


	29://RB輸出通知

			IF NOT RunParameter.Dual_TwiceClip THEN
				nLeftStep		:= 1;
				ELSE
				strLeftText:='P3 moving';
				nLeftStep		:= 30;
				fbMC_MoveAbsoluteCA_Left.Execute	:=TRUE;
				fbMC_MoveAbsoluteCA_Left.Position	:= RunParameter.Dual_LoadOutSecPos;
			END_IF;

	30:

		IF fbMC_MoveAbsoluteCA_Left.Done THEN
			strRightText:='P3 Pos Call RB';
			fbMC_MoveAbsoluteCA_Left.Execute	:= FALSE;
			RB_CS_PickIO.cmd_bPartInPos	:= TRUE;
			nLeftStep	:=31;
		END_IF

	31:
		IF Hmi_bPickFeedTest THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			Hmi_bPickFeedTest			:=FALSE;
			nLeftStep					:= 1;
		END_IF
		IF RB_CS_PickIO.fb_bPackFinish	THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			nLeftStep	:= 32;
		END_IF
	32:
		IF NOT RB_CS_PickIO.fb_bPackFinish	THEN
			nLeftStep	:= 1;
		END_IF

END_CASE

CASE nRightStep OF
	0:
		strRightText:='Para Set';
		MC_TouchProbeDual2.Execute:= TRUE;
		IF MC_TouchProbeDual2.Busy THEN
			nRightStep	:=1;
		END_IF;
	1:
			strRightText:='P1 moving';
			fbMC_MoveAbsoluteCA_Right.Execute:= TRUE;
			fbMC_MoveAbsoluteCA_Right.Position	:= RunParameter.Dual_LoadInPos;
			fbMC_MoveAbsoluteCA_Right.Velocity	:=RunParameter.Dual_Velo;
			fbMC_MoveAbsoluteCA_Right.Acceleration	:= 15000;
			fbMC_MoveAbsoluteCA_Right.Deceleration	:= 15000;
			fbMC_MoveAbsoluteCA_Right.Jerk			:= 50000;
			RifgtLoadinQty	:=0;
			nRightStep		:= 5;

	5:
		IF Axis_DualServo2.Status.NotMoving THEN
			strRightText:='P1 Coupled';
			ELSE
			strRightText:='P1 moving';
		END_IF;
		IF fbMC_MoveAbsoluteCA_Right.Done THEN
			strRightText:='P1 Pos';
			fbMC_MoveAbsoluteCA_Right.Execute	:= FALSE;
			nRightStep	:=10;
		END_IF
	10:
				strRightText	:='P1 Pos';
				strRightText	:= CONCAT(strRightText,UINT_TO_STRING(RifgtLoadinQty));
		IF slot[1].LoadIn THEN
			RifgtLoadinQty	:= 	RifgtLoadinQty+1;
			ResOut();
			IF RifgtLoadinQty < RunParameter.Dual_LoadInQty[wSlot] THEN
				fbMC_MoveAbsoluteCA_Right.Execute	:= TRUE;
				fbMC_MoveAbsoluteCA_Right.Position	:= fbMC_MoveAbsoluteCA_Right.Position + RunParameter.Dual_ModulePitchLength;
				fbMC_MoveAbsoluteCA_Right.Velocity	:= 1500;
				nRightStep	:= 5;
				ELSE
				wSlot								:= wSlot + 1;
				IF RunParameter.Dual_LoadInQty[wSlot] = 0 THEN
					wSlot	:= 0;
				END_IF
				fbMC_MoveAbsoluteCA_Right.Execute	:= TRUE;
				fbMC_MoveAbsoluteCA_Right.Position	:= RunParameter.Dual_LoadOutPos;
				fbMC_MoveAbsoluteCA_Right.Velocity		:=RunParameter.Dual_Velo;
				fbMC_MoveAbsoluteCA_Right.Acceleration	:= Parameter_PERSISTENT.Setting_DualServoAcc;
				fbMC_MoveAbsoluteCA_Right.Deceleration	:= Parameter_PERSISTENT.Setting_DualServoDec;
				fbMC_MoveAbsoluteCA_Right.Jerk			:= Parameter_PERSISTENT.Setting_DualServoJerk;
				strRightText:='P2 moving';
				nRightStep	:= 20;
			END_IF;

		END_IF

	20://裝完
		IF Axis_DualServo2.Status.NotMoving THEN
			strRightText:='P2 Coupled';
			ELSE
			strRightText:='P2 moving';
		END_IF


		IF fbMC_MoveAbsoluteCA_Right.Done THEN
			strRightText:='P2 Pos Call RB';
			fbMC_MoveAbsoluteCA_Right.Execute	:= FALSE;
			RB_CS_PickIO.cmd_bPartInPos	:= TRUE;
			nRightStep	:= 24;
		END_IF
	24://RB輸出通知
		IF RB_CS_PickIO.fb_bPackFinish	THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			nRightStep	:= 25;
		END_IF
			IF Hmi_bPickFeedTest THEN
				RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
				Hmi_bPickFeedTest			:=FALSE;
				nRightStep					:= 29;
			END_IF
	25:
		IF NOT RB_CS_PickIO.fb_bPackFinish	THEN
			nRightStep	:= 29;
		END_IF


	29:
			IF NOT RunParameter.Dual_TwiceClip THEN
				nRightStep		:= 1;
				ELSE
				strRightText:='P3 moving';
				nRightStep		:= 30;
				fbMC_MoveAbsoluteCA_Right.Execute	:=TRUE;
				fbMC_MoveAbsoluteCA_Right.Position	:= RunParameter.Dual_LoadOutSecPos;

			END_IF;
	30:

		IF fbMC_MoveAbsoluteCA_Right.Done THEN
			strRightText:='P3 Pos Call RB';
			fbMC_MoveAbsoluteCA_Right.Execute	:= FALSE;
			RB_CS_PickIO.cmd_bPartInPos	:= TRUE;
			nRightStep	:=31;
		END_IF
	31:
		IF Hmi_bPickFeedTest THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			Hmi_bPickFeedTest			:=FALSE;
			nRightStep					:= 1;
		END_IF
		IF RB_CS_PickIO.fb_bPackFinish	THEN
			RB_CS_PickIO.cmd_bPartInPos	:= FALSE;
			nRightStep	:= 32;
		END_IF
	32:
		IF NOT RB_CS_PickIO.fb_bPackFinish	THEN
			nRightStep	:= 1;
		END_IF

END_CASE

CASE nStopStep OF
	0:
		Motor_LoadIn.qRun	:= TRUE;
		//Cyl_FlyIn_Pass		:= TRUE;
		(*
		IF nLeftStep < 20 THEN
			IF fbMC_MoveAbsoluteCA_Left.Busy AND Axis_DualServo1.Status.NotMoving THEN
				Motor_LoadIn.qRun	:= FALSE;
				Cyl_FlyIn_Pass		:= FALSE;
			END_IF;
			IF nRightStep < 5 THEN
				Motor_LoadIn.qRun	:= FALSE;
				Cyl_FlyIn_Pass		:= FALSE;
			END_IF
			IF nRightStep = 10 THEN
				Motor_LoadIn.qRun	:= TRUE;
				Cyl_FlyIn_Pass		:= TRUE;
			END_IF

		END_IF;

		IF nRightStep < 20 THEN
			IF fbMC_MoveAbsoluteCA_Right.Busy AND Axis_DualServo2.Status.NotMoving THEN
				Motor_LoadIn.qRun	:= FALSE;
				Cyl_FlyIn_Pass		:= FALSE;
			END_IF;
			IF nLeftStep < 5 THEN
				Motor_LoadIn.qRun	:= FALSE;
				Cyl_FlyIn_Pass		:= FALSE;
			END_IF
			IF nLeftStep = 10 THEN
				Motor_LoadIn.qRun	:= TRUE;
				Cyl_FlyIn_Pass		:= TRUE;
			END_IF
		END_IF
	//IF nLeftStep < 20 AND nRightStep < 20 THEN
	//	Motor_LoadIn.qRun	:= TRUE;
	//	Cyl_FlyIn_Pass		:= TRUE;
	//END_IF
*)
END_CASE
//_label1 : ;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResInData" Id="{a3607c70-fcc4-4d57-86e2-c37b50b9c241}">
      <Declaration><![CDATA[METHOD ResInData :BOOL;
VAR_INPUT
	Pos	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF ConvQty < 5 THEN
ConvQty:= ConvQty+1;
slot[ConvQty].ScanIn			:= TRUE;
slot[ConvQty].LatchPosition		:= Pos;
slot[ConvQty].GearInPosition	:= Pos + RunParameter.Fly_Disdance;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResOut" Id="{a8e711c4-5156-4c4c-99a8-7c128b3a1936}">
      <Declaration><![CDATA[METHOD ResOut
VAR_IN_OUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ConvQty <>0 THEN
	FOR i := 1 TO ConvQty BY 1 DO
		slot[i]:= slot[i+1];
	END_FOR
	ConvQty	:= ConvQty - 1;
END_IF;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RingTest" Id="{ef03d1c5-f143-45bc-82e1-6bffa5c89f76}">
      <Declaration><![CDATA[METHOD RingTest : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Status" Id="{27518ed8-e04c-47f5-b017-8ecf03747c3f}">
      <Declaration><![CDATA[PROPERTY Status : STRING(50)]]></Declaration>
      <Get Name="Get" Id="{e69e1cad-09d7-4a63-bbdf-45fffd92ba9f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="STOP" Id="{34fc336d-748d-44db-921c-063a3eea311b}">
      <Declaration><![CDATA[METHOD STOP : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Axis_FlyIn.Status.Moving THEN
	Axis_FlyIn.Stop();
END_IF

IF Axis_DualServo1.Status.Moving THEN
	Axis_DualServo1.Stop();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UngroupAllAxes" Id="{f8fe0619-623e-49d7-9d86-2152d13e7600}">
      <Declaration><![CDATA[METHOD UngroupAllAxes : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbMC_GroupDisable.Execute:= TRUE;
IF fbMC_GroupDisable.Done THEN
	fbMC_UngroupAllAxes.Execute:= TRUE;
END_IF;
fbMC_GroupEnable.Execute:= FALSE;
fbAddAxis[1].Execute:= FALSE;
fbAddAxis[2].Execute:= FALSE;



