<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Ass_DualServo" Id="{29cca747-7da9-4f26-a5ee-de90be653942}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Ass_DualServo IMPLEMENTS ITF_AutoStructCommand
VAR_INPUT
END_VAR
VAR_OUTPUT
	strText,strLeftText,strRightText							:STRING;
	nInitialGroupErrorId : UDINT; // Group error captured before reset / on failure
	nInitialCommandErrorId : UDINT; // AddAxis, GroupReset or GroupEnable error
END_VAR
VAR
	tmrAuto														:TON:= (PT := TIME#1S0MS);
	_bError													:BOOL;
	_tmrT0														:TON;
	nInitiStep,nStopStep									:INT;
	fbMC_GearIn													:MC_GearIn;
	fbMC_GearOut												:MC_GearOut;
	bDual1First,bDual2First,bDual1Done,bDual2Done				:BOOL;
	MC_SetPositionLeft,MC_SetPositionRight,MC_SetPositionCon	:MC_SetPosition;
	L_Home,R_Home:MC_Home 										:=(HomingMode := MC_HOMINGMODE.MC_ForceCalibration);
	MC_GroupReset												:MC_GroupReset;
	LatchDual1Pos,LatchDual2Pos									:LREAL;
	ConvQty	:INT;
	_bInitialScan	:BOOL;
	fbCommandOffTrig									:Tc2_Standard.F_TRIG;
	

	//Group
	tmrGroupInitial : TON;
	fbMC_UngroupAllAxes											:MC_UngroupAllAxes;
	fbMC_GroupDisable											:MC_GroupDisable;
	fbAddAxis													:ARRAY[1..2] OF MC_AddAxisToGroup;
	fbMC_GroupEnable											:MC_GroupEnable;
	fbMC_MoveAbsoluteCA_Left,fbMC_MoveAbsoluteCA_Right			:MC_MoveAbsoluteCA := (Options := (GapControlMode := MC_GAP_CONTROL_MODE.mcGapControlModeFast));
	nStep,nLeftStep,nRightStep,i								:INT;
	LeftLoadinQty,RifgtLoadinQty								:UINT;
	fbMC_StopFly												:MC_Stop;
	MC_TouchProbeDual1,MC_TouchProbeDual2,MC_TouchProbeFly		:MC_TouchProbe;
	TouchTriggerDual1,TouchTriggerDual2,TouchTriggerFly			:TRIGGER_REF;
	MC_AbortTrigger1,MC_AbortTrigger2							:MC_AbortTrigger;
	tmrT1	:TON := (ET := TIME#2S0MS);
	tmrFlyinDef	:TON;
	_bProcessScan: BOOL;
	_FlyInCalibrationPos	:LREAL;
	//
	fbSensorTrigger	:R_TRIG;
	dwSenesorTriggerTimes	:DWORD;

	wSlot: INT;
	bPause: BOOL;
	fRampTime: REAL;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Instance();
fbSensorTrigger(CLK:=Axis_FlyIn.DI.19);
IF fbSensorTrigger.Q THEN
	dwSenesorTriggerTimes	:= dwSenesorTriggerTimes+1;
END_IF



//Modhed
IF NOT _bProcessScan AND NOT _bInitialScan THEN
	MC_TouchProbeDual1.Execute	:= FALSE;
	MC_TouchProbeDual2.Execute	:= FALSE;
	strText:=strLeftText:=strRightText:='';
END_IF


IF NOT _bInitialScan THEN
	nInitiStep	:= 0;
END_IF

IF NOT _bProcessScan THEN
	nStep	:= 0;
	nLeftStep	:=0;
	nRightStep	:=0;
END_IF
fbCommandOffTrig(CLK:=_bProcessScan);
IF fbCommandOffTrig.Q THEN
	Motor_LoadIn.qRun	:= FALSE;
	HardwareIO.Axis_load1.Stop();
	HardwareIO.Axis_load2.Stop();
	HardwareIO.Axis_FlyIn.Stop();
END_IF


_bInitialScan:=FALSE;
_bProcessScan:=FALSE;]]></ST>
    </Implementation>
    <Method Name="_Clearfb" Id="{598a0349-536b-4a20-8dd2-78f75dd933ad}">
      <Declaration><![CDATA[METHOD _Clearfb : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAddAxis[1].Execute:= FALSE;
fbAddAxis[2].Execute:= FALSE;
fbMC_GroupEnable.Execute:= FALSE;
MC_GroupReset.Execute:= FALSE;
tmrGroupInitial(IN:=FALSE);
fbMC_GroupDisable.Execute:= FALSE;
fbMC_UngroupAllAxes.Execute:= FALSE;
fbMC_MoveAbsoluteCA_Left.Execute:=FALSE;
fbMC_MoveAbsoluteCA_Right.Execute:=FALSE;
_tmrT0(IN:=FALSE);
nInitiStep:=0;
nStep	:=0;
nLeftStep	:=0;
nRightStep	:=0;
		MC_AbortTrigger1.Execute:= FALSE;
		MC_AbortTrigger2.Execute:= FALSE;
		MC_TouchProbeDual1.Execute:= FALSE;
		MC_TouchProbeDual2.Execute:= FALSE;
		]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearData" Id="{8e334220-b75f-48c6-a489-d8e564cd62d1}">
      <Declaration><![CDATA[METHOD ClearData : BOOL
VAR_INPUT
END_VAR
VAR
	clear	:ST_SlotData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i :=  1TO 5 DO
	slot[i]	:= clear	;
END_FOR;
ConvQty	:= 0;]]></ST>
      </Implementation>
    </Method>
